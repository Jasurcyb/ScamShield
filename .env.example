ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
FIREWORKS_API_KEY=your_fireworks_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Public Telegram @handle or support email shown in /privacy. Required before public launch.
SUPPORT_CONTACT=@your_support_handle

# Public API safety limits
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=20000000
MAX_TEXT_CHARS=10000
MAX_REQUESTS_PER_MINUTE=30

# Comma-separated browser origins. Leave empty for Telegram-only deployments.
CORS_ALLOW_ORIGINS=

# Concurrency & load protection
# Max analyses running at the same time (API + bot share this cap); excess fails fast with 429/503.
MAX_CONCURRENT_ANALYSES=20
# Worker threads for the sync pipeline (LLM calls, PIL, forensics). ~2x MAX_CONCURRENT_ANALYSES is a sane floor.
THREAD_POOL_SIZE=32
# Per-chat analyses per minute in the Telegram bot.
BOT_MAX_ANALYSES_PER_MINUTE=10
# API server: worker processes and the connection cap (excess connections get 503).
UVICORN_WORKERS=2
UVICORN_MAX_CONNECTIONS=120
